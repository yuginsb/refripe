# Copie en supabase/functions/.env pour `supabase functions serve --env-file supabase/functions/.env`
# En production : `supabase secrets set NOM=valeur` (jamais de clé dans le code ni dans git).
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement.

# sandbox (confirmation automatique, aucun argent) | live
PAYMENT_MODE=sandbox
SANDBOX_AUTO_CONFIRM=true
SANDBOX_WEBHOOK_SECRET=change-me-local-only
APP_URL_SCHEME=refripe

# Wave Checkout (live)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_AGGREGATED_MERCHANT_ID=

# Orange Money Web Pay (live)
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_COUNTRY=ci
OM_CURRENCY=XOF
