// Supabase settings. Leave empty to run the app on built-in demo data.
// Put real values in Config/Secrets.local.xcconfig (git-ignored), e.g.:
//   SUPABASE_URL = https:/$()/abcdefgh.supabase.co
//   SUPABASE_ANON_KEY = eyJhbGciOi...
// (the "/$()/" trick is needed because "//" starts a comment in xcconfig files)
SUPABASE_URL =
SUPABASE_ANON_KEY =
#include? "Secrets.local.xcconfig"
